# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=paged-kv-serving
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run paged-kv-serving generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Checkpoint served at start-up. Build one with:
#   uv run paged-kv-serving build-checkpoint --out var/checkpoint
# Set APP_CHECKPOINT_MANIFEST_SHA256 to the manifest digest printed by that command and a
# swapped checkpoint is refused instead of served.
APP_CHECKPOINT_DIR=var/checkpoint
APP_CHECKPOINT_MANIFEST_SHA256=
APP_WEIGHTS_ROOT=var/weights

# Engine sizing. num_blocks * block_size is the KV pool in tokens; one block of a 4-layer,
# 128-dimension model is about 16 KiB of float32 keys and values.
APP_ENGINE_BLOCK_SIZE=16
APP_ENGINE_NUM_BLOCKS=512
APP_ENGINE_MAX_BATCHED_TOKENS=256
APP_ENGINE_MAX_RUNNING_SEQS=32
APP_ENGINE_MAX_PROMPT_TOKENS=512
APP_ENGINE_MAX_NEW_TOKENS=128
APP_ENGINE_MAX_CONTEXT_TOKENS=1024
APP_ENGINE_MAX_QUEUED_SEQUENCES=1024
APP_ENGINE_ENABLE_PREFIX_CACHE=true
# per_key keeps prompt reuse inside one tenant; global trades that isolation for a higher hit rate.
APP_ENGINE_PREFIX_CACHE_SCOPE=per_key
APP_ENGINE_PROFILE_ON_START=true
# BLAS threads per process (empty leaves BLAS alone). One is fastest for a model this small.
APP_ENGINE_BLAS_THREADS=1
APP_DRAIN_TIMEOUT_SECONDS=20
# Hard ceiling on a single request's wall time; the request is aborted and its blocks freed.
APP_REQUEST_TIMEOUT_SECONDS=60

# Workload drift: PSI of recent prompt lengths against the first APP_DRIFT_REFERENCE_SIZE ones.
APP_DRIFT_REFERENCE_SIZE=256
APP_DRIFT_WINDOW=256

# Per-key entitlements, comma separated. Each entry is
#   <api key sha256>:<interactive|batch>:<tokens per minute>:<max concurrent sequences>
#   :<max prompt tokens>:<max new tokens>:<1 for admin, else 0>[:<max parallel samples n, 1-8>]
# An n-way request counts n sequences against the concurrency cap and is charged
# prompt + n * max_new_tokens; n above the key's limit (default 1) is refused with 400.
# A key with no entry cannot call the engine at all.
APP_KEY_POLICIES=

APP_DATA_DIR=var
# HMAC key (32+ characters) for the admin audit chain in APP_DATA_DIR/admin-audit.jsonl. Empty:
# plain SHA-256, which anyone who can write the file can recompute. Keep it out of the data volume;
# `paged-kv-serving audit verify` reads it from this same variable.
APP_AUDIT_HMAC_KEY=
